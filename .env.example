# Legal Compass — Environment Configuration Template
# Copy this file to .env.local for local development.

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Supabase Integration (For persistent backend storage if configured)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Maximum Upload File Size in Bytes (Default: 15MB = 15728640)
NEXT_PUBLIC_MAX_FILE_SIZE_BYTES=15728640
